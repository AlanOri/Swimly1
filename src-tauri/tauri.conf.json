{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "swimly",
  "version": "0.1.0",
  "identifier": "com.alane.swimly",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Swimly",
        "width": 1100,
        "height": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "resources": ["yt-dlp/**/*"],
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE3QTkwMDFCMTExMDIxOTUKUldTVklSQVJHd0NwcDA3clFUbCtDcjIyenZybDdLbHRwcjF1K0ZSbk1KMjI2NGk5akM1QkdoRWcK",
      "endpoints": [
        "https://github.com/OrioliAlan/Swimly1/releases/latest/download/latest.json"
      ]
    }
  }
}
